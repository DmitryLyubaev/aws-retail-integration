{
  "name": "aws-retail-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "node scripts/test.mjs",
    "test:one": "node scripts/test.mjs",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test",
    "demo:offline": "npm run build && node scripts/demo.mjs",
    "build:cleanup": "node scripts/build.mjs",
    "check:infra": "node scripts/infra.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "3.1157.0",
    "@aws-sdk/client-rds": "3.1157.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/client-sqs": "3.1157.0",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
